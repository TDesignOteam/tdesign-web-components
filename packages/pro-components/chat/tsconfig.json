{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@tdesign/web-components-chat": ["."],
      "@tdesign/web-components-chat/*": ["./*"],
      "@tdesign/web-components": ["../../components"],
      "@tdesign/web-components/*": ["../../components/*"],
      "@tdesign/web-components-shared": ["../../shared/src"],
      "@tdesign/web-components-shared/*": ["../../shared/src/*"],
      "@common/*": ["../../common/*"],
      "@": ["."]
    }
  },
  "references": [{ "path": "../../shared/tsconfig.build.json" }]
}
