{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "lib",
    "paths": {
      "@tdesign/web-components-ui": ["src"],
      "@tdesign/web-components-ui/*": ["src/*"],
      "@tdesign/web-components-shared": ["../shared/src"],
      "@tdesign/web-components-shared/*": ["../shared/src/*"],
      "@common/*": ["src/_common/*"],
      "@": ["src"]
    }
  },
  "include": ["src"],
  "exclude": ["**/*.jsx", "**/**/_usage/*", "**/**/__tests__/*", "node_modules", "src/_common", "dist", "lib", "esm", "cjs", "es"]
}
