{
  "name": "@tdesign/web-components-ui",
  "version": "1.3.0",
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "author": "tdesign",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf es lib dist esm cjs",
    "build": "NODE_ENV=production rollup -c rollup.config.mjs",
    "build:tsc": "npm-run-all --parallel build:tsc-*",
    "build:tsc-lib": "tsc --emitDeclarationOnly -d -p ./tsconfig.json --outDir lib/",
    "build:tsc-esm": "tsc --emitDeclarationOnly -d -p ./tsconfig.json --outDir esm/"
  },
  "files": [
    "esm",
    "es",
    "lib",
    "cjs",
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "dist/*",
    "src/**/*.{ts,tsx}",
    "cjs/**",
    "esm/**",
    "lib/**"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.7",
    "@popperjs/core": "^2.11.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "copy-to-clipboard": "^3.3.3",
    "dayjs": "^1.11.19",
    "htm": "^3.1.1",
    "immer": "^10.1.1",
    "lodash-es": "^4.17.21",
    "omi": "^7.7.13",
    "omi-transition": "^0.1.11",
    "tailwind-merge": "^2.2.1",
    "tdesign-icons-web-components": "^0.3.2"
  },
  "devDependencies": {
    "@tdesign/web-components-shared": "workspace:^"
  },
  "peerDependencies": {
    "omi": "^7.7.0"
  }
}
