{
  "name": "@tdesign/web-components-shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "author": "tdesign",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist tsconfig.build.tsbuildinfo",
    "build": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "clsx": "catalog:runtime",
    "lodash-es": "catalog:runtime",
    "raf": "catalog:runtime",
    "tailwind-merge": "catalog:runtime"
  },
  "peerDependencies": {
    "omi": "catalog:runtime"
  }
}
