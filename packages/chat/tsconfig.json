{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "lib",
    "paths": {
      "@tdesign/web-components-chat": ["src"],
      "@tdesign/web-components-chat/*": ["src/*"],
      "@tdesign/web-components-ui": ["../ui/src"],
      "@tdesign/web-components-ui/*": ["../ui/src/*"],
      "@tdesign/web-components-shared": ["../shared/src"],
      "@tdesign/web-components-shared/*": ["../shared/src/*"],
      "@tdesign/ai-chat-engine": ["../_ai-core/packages/chat-engine/index.ts"],
      "@tdesign/ai-chat-engine/*": ["../_ai-core/packages/chat-engine/*"],
      "@tdesign/ai-shared": ["../_ai-core/packages/shared/index.ts"],
      "@tdesign/ai-shared/*": ["../_ai-core/packages/shared/*"],
      "tdesign-web-components-chat": ["src"],
      "tdesign-web-components-chat/*": ["src/*"],
      "@common/*": ["../_common/*"],
      "@": ["src"]
    }
  },
  "include": ["src", "../../typings.d.ts"],
  "exclude": ["**/*.jsx", "**/**/_usage/*", "**/**/__tests__/*", "node_modules", "../_common", "dist", "lib", "esm", "cjs", "es"]
}
