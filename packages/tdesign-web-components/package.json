{
  "name": "@tdesign/web-components",
  "version": "1.3.1-alpha.11",
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./*": {
      "import": "./lib/*/index.js",
      "types": "./lib/*/index.d.ts"
    },
    "./lib/*": "./lib/*",
    "./lib/style/index.css": "./lib/style/index.css",
    "./lib/style/*.css": "./lib/style/*.css"
  },
  "author": "tdesign",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf es lib dist esm cjs && node ../../script/build.mjs cleanup-dts",
    "build": "pnpm --filter @tdesign/common-js build && pnpm --filter @tdesign/web-components-shared build && pnpm --filter @tdesign/components build && node ../../script/build/vite-lib-build.mjs . && node ../../script/build.mjs sync-dts ui"
  },
  "files": [
    "esm",
    "es",
    "lib",
    "cjs",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "dist/*",
    "lib/style/**/*",
    "cjs/**",
    "esm/**"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "dayjs": "^1.11.19",
    "lodash-es": "^4.17.21",
    "omi": "^7.7.13",
    "omi-transition": "^0.1.11",
    "tdesign-icons-web-components": "^0.3.2"
  },
  "devDependencies": {
    "@tdesign/components": "workspace:^",
    "@tdesign/vite-config": "workspace:^",
    "@tdesign/web-components-shared": "workspace:^"
  },
  "peerDependencies": {
    "omi": "^7.7.0"
  },
  "description": "TDesign Web Components Library",
  "keywords": [
    "omi",
    "web-components",
    "tdesign",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tencent/tdesign-web-components.git",
    "directory": "packages/tdesign-web-components"
  },
  "homepage": "https://github.com/Tencent/tdesign-web-components/blob/main/README.md",
  "bugs": {
    "url": "https://github.com/Tencent/tdesign-web-components/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
