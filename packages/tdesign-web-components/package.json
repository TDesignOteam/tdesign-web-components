{
  "name": "@tdesign/web-components",
  "version": "1.3.1-alpha.13",
  "description": "TDesign Web Components Library",
  "type": "module",
  "main": "./esm/index.js",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js",
      "default": "./esm/index.js"
    },
    "./*": {
      "types": "./esm/*/index.d.ts",
      "import": "./esm/*/index.js",
      "default": "./esm/*/index.js"
    },
    "./style/index.css": "./esm/style/index.css",
    "./style/*": "./esm/style/*"
  },
  "author": "tdesign",
  "license": "MIT",
  "keywords": [
    "omi",
    "web-components",
    "tdesign",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tencent/tdesign-web-components.git",
    "directory": "packages/tdesign-web-components"
  },
  "homepage": "https://github.com/Tencent/tdesign-web-components/blob/main/README.md",
  "bugs": {
    "url": "https://github.com/Tencent/tdesign-web-components/issues"
  },
  "scripts": {
    "build": "vite build"
  },
  "files": [
    "dist",
    "esm",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "dist/**",
    "**/style/**",
    "**/*.css"
  ],
  "unpkg": "./dist/web-components.min.js",
  "jsdelivr": "./dist/web-components.min.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@popperjs/core": "catalog:runtime",
    "classnames": "catalog:runtime",
    "clsx": "catalog:runtime",
    "dayjs": "catalog:runtime",
    "lodash-es": "catalog:runtime",
    "omi": "catalog:runtime",
    "omi-transition": "catalog:runtime",
    "raf": "catalog:runtime",
    "tdesign-icons-web-components": "catalog:runtime"
  }
}
