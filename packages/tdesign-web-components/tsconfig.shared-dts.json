{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "./lib",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "sourceMap": false,
    "skipLibCheck": true,
    "noEmitOnError": false
  },
  "include": ["../shared/src/**/*.ts", "../shared/src/**/*.tsx"],
  "exclude": ["**/__tests__/**", "node_modules"]
}
