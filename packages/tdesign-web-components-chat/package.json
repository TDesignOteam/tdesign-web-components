{
  "name": "@tdesign/web-components-chat",
  "version": "1.3.1-alpha.11",
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./*": {
      "import": "./lib/*/index.js",
      "types": "./lib/*/index.d.ts"
    },
    "./lib/*": "./lib/*",
    "./lib/style/index.css": "./lib/style/index.css",
    "./lib/style/*.css": "./lib/style/*.css"
  },
  "author": "tdesign",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf es lib dist esm cjs && node ../../script/build.mjs cleanup-dts",
    "build": "node ../../script/build.mjs ensure-ai-types && pnpm --filter @tdesign/common-js build && pnpm --filter @tdesign/web-components-shared build && pnpm --filter @tdesign/pro-components-chat build && node ../../script/build/vite-lib-build.mjs . && node ../../script/build.mjs sync-dts chat"
  },
  "files": [
    "esm",
    "es",
    "lib",
    "cjs",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "dist/*",
    "lib/style/**/*",
    "cjs/**",
    "esm/**"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "peerDependencies": {
      "@tdesign/web-components": "^1.3.1",
      "omi": "^7.7.0"
    },
    "dependencies": {
      "@tdesign/ai-chat-engine": "^0.1.0"
    }
  },
  "dependencies": {
    "@tdesign/ai-chat-engine": "workspace:^",
    "cherry-markdown": "0.11.0-alpha-5",
    "immer": "^10.1.1",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@tdesign/pro-components-chat": "workspace:^",
    "@tdesign/vite-config": "workspace:^",
    "@tdesign/web-components": "workspace:^",
    "@tdesign/web-components-shared": "workspace:^"
  },
  "peerDependencies": {
    "@tdesign/web-components": "workspace:^",
    "omi": "^7.7.0"
  },
  "description": "TDesign Web Components Chat Library",
  "keywords": [
    "omi",
    "web-components",
    "tdesign",
    "ai-chat",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tencent/tdesign-web-components.git",
    "directory": "packages/tdesign-web-components-chat"
  },
  "homepage": "https://github.com/Tencent/tdesign-web-components/blob/main/README.md",
  "bugs": {
    "url": "https://github.com/Tencent/tdesign-web-components/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
