{
  "name": "@tdesign/web-components-chat",
  "version": "1.3.1-alpha.11",
  "description": "TDesign Web Components Chat Library",
  "type": "module",
  "main": "./esm/index.js",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js",
      "default": "./esm/index.js"
    },
    "./*": {
      "types": "./esm/*/index.d.ts",
      "import": "./esm/*/index.js",
      "default": "./esm/*/index.js"
    },
    "./style/index.css": "./esm/style/index.css",
    "./style/*": "./esm/style/*"
  },
  "author": "tdesign",
  "license": "MIT",
  "keywords": [
    "omi",
    "web-components",
    "tdesign",
    "ai-chat",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tencent/tdesign-web-components.git",
    "directory": "packages/tdesign-web-components-chat"
  },
  "homepage": "https://github.com/Tencent/tdesign-web-components/blob/main/README.md",
  "bugs": {
    "url": "https://github.com/Tencent/tdesign-web-components/issues"
  },
  "scripts": {
    "build": "vite build"
  },
  "files": [
    "dist",
    "esm",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "dist/**",
    "**/style/**",
    "**/*.css"
  ],
  "unpkg": "./dist/web-components-chat.min.js",
  "jsdelivr": "./dist/web-components-chat.min.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@tdesign/ai-chat-engine": "^0.1.0",
    "cherry-markdown": "0.11.0-alpha-5",
    "clsx": "^2.1.1",
    "immer": "^10.1.1",
    "lodash-es": "^4.17.21",
    "raf": "^3.4.1",
    "tdesign-icons-web-components": "^0.3.2"
  },
  "peerDependencies": {
    "@tdesign/web-components": "^1.3.1",
    "omi": "^7.7.0"
  },
  "devDependencies": {
    "@tdesign/pro-components-chat": "workspace:^",
    "@tdesign/vite-config": "workspace:^",
    "@tdesign/web-components": "workspace:^",
    "omi": "^7.7.13"
  }
}
