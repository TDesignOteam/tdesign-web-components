{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "./lib",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "sourceMap": false,
    "skipLibCheck": true,
    "noEmitOnError": false
  },
  "include": ["../components/**/*.ts", "../components/**/*.tsx"],
  "exclude": [
    "**/*.jsx",
    "**/_example/**",
    "**/**/_usage/*",
    "**/**/__tests__/*",
    "node_modules",
    "dist",
    "lib",
    "../components/site"
  ]
}
