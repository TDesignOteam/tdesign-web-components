{
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "init": "git submodule update --init",
    "start": "pnpm run dev:ui",
    "dev:ui": "cd packages/tdesign-web-components/site && vite",
    "dev:chat": "cd packages/tdesign-web-components-chat/site && vite",
    "site:ui": "cd packages/tdesign-web-components/site && vite build",
    "site:chat": "cd packages/tdesign-web-components-chat/site && vite build",
    "build": "pnpm run \"/^build:/\"",
    "build:ui": "cd packages/tdesign-web-components && pnpm run build",
    "build:chat": "cd packages/tdesign-web-components-chat && pnpm run build",
    "test": "echo \"no test specified,work in process\"",
    "lint": "eslint --ext .ts,.tsx packages/components packages/pro-components/chat",
    "lint:fix": "eslint --fix --ext .ts,.tsx packages/components packages/pro-components/chat",
    "generate:entry": "node ./script/generate-entry.js",
    "preinstall": "node ./script/check-node-version.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/components/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "packages/pro-components/chat/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "packages/tdesign-web-components/site/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/types": "^7.26.9",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/format": "^20.5.0",
    "@json-render/core": "^0.17.0",
    "@rollup/pluginutils": "^5.4.0",
    "@tailwindcss/typography": "^0.5.10",
    "@types/lodash-es": "^4.17.12",
    "@types/prismjs": "^1.26.3",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "autoprefixer": "^10.4.16",
    "cors": "^2.8.5",
    "eslint": "^8.45.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "express": "^4.17.3",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "husky": "^9.0.11",
    "less": "^4.2.2",
    "lint-staged": "^15.2.5",
    "omi-router": "4.1.8",
    "omi-suspense": "0.1.6",
    "postcss": "^8.4.31",
    "postcss-import": "^16.1.0",
    "prettier": "3.0.3",
    "prismjs": "^1.29.0",
    "rimraf": "^5.0.7",
    "sass": "^1.55.0",
    "tailwindcss": "^3.3.3",
    "tdesign-icons-view": "^0.2.7",
    "tdesign-site-components": "^0.15.4",
    "tdesign-theme-generator": "^1.0.16",
    "tslib": "^2.6.2",
    "typescript": "^5.8.2",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vite-plugin-tdoc": "^2.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
