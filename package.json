{
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "init": "git submodule update --init",
    "start": "pnpm run dev:ui",
    "dev:ui": "pnpm --filter @tdesign/web-components-site dev",
    "dev:chat": "pnpm --filter @tdesign/web-components-chat-site dev",
    "site:ui": "pnpm --filter @tdesign/web-components-site build",
    "site:chat": "pnpm --filter @tdesign/web-components-chat-site build",
    "preview:ui": "pnpm --filter @tdesign/web-components-site preview",
    "preview:chat": "pnpm --filter @tdesign/web-components-chat-site preview",
    "build": "pnpm run \"/^build:/\"",
    "build:ui": "pnpm --filter @tdesign/web-components build",
    "build:chat": "pnpm --filter @tdesign/web-components-chat build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate:entry": "node ./packages/vite-config/src/generate-entry.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/components/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "packages/pro-components/chat/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "packages/tdesign-web-components/site/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "packages/tdesign-web-components-chat/site/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.10",
    "@types/lodash-es": "^4.17.12",
    "autoprefixer": "^10.4.16",
    "cors": "^2.8.5",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "express": "^4.17.3",
    "globals": "^16.2.0",
    "husky": "^9.0.11",
    "less": "^4.2.2",
    "lint-staged": "^15.2.5",
    "omi-router": "4.1.8",
    "postcss": "^8.4.31",
    "prettier": "3.0.3",
    "prismjs": "^1.29.0",
    "rimraf": "^5.0.7",
    "tailwindcss": "^3.3.3",
    "tdesign-icons-view": "^0.2.7",
    "tdesign-site-components": "^0.15.4",
    "tdesign-theme-generator": "^1.0.16",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
